# Copy this file to .env and fill in the values. Never commit .env.

# A long random string (protects login cookies). Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
# The address people use to open the app. On a VPS: https://your-domain.be
BASE_URL=http://localhost:8000
# Only needed on a VPS with HTTPS (used by Caddy)
DOMAIN=

# --- Telegram alerts (create a bot with @BotFather in Telegram) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=

# --- E-mail alerts: a real SMTP provider (e.g. Brevo, Mailgun, Postmark, your mail host) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@your-domain.be
SMTP_STARTTLS=true
# Where Ops/QA warnings and the weekly summary go (the founder)
ADMIN_EMAIL=

# --- Market ---
PROVINCE=antwerpen
# Max active clients per municipality and segment (0 = unlimited). Per-municipality caps: Admin -> Users.
DEFAULT_SEGMENT_CAP=0

# --- Feature flags (leave off until reviewed) ---
# Portal cross-check (Immoweb/Zimmo first-seen time only). Switch on after legal review.
PORTAL_CROSSCHECK_ENABLED=false
# Phase 2: visit requests to agencies. approve = one click per message; auto = send immediately.
OUTREACH_ENABLED=false
OUTREACH_MODE=approve
# Render JavaScript-only sites with a headless browser (needs: pip install ".[browser]" && playwright install chromium)
ENABLE_PLAYWRIGHT=false

# --- Optional AI help (works fine without it) ---
LLM_PROVIDER=none
# ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5

# --- Enrichment endpoints (see DECISIONS.md "Needs verification"; empty = skipped) ---
EPC_LOOKUP_URL=
FLOOD_LOOKUP_URL=
PERMITS_LOOKUP_URL=
# STATBEL_URL=https://statbel.fgov.be/sites/default/files/files/opendata/immo/vastgoed_2010_9999.zip

# --- Politeness (do not lower below 5 seconds) ---
MIN_REQUEST_INTERVAL=5
